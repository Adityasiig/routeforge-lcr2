DATA_DIR=.data
BUILD_WORKER_PATH=workers/build-job.mjs
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication. AUTH_SECRET signs the session cookie — use a long random value.
AUTH_SECRET=replace-with-a-long-random-string

# Multi-account, multi-entity login. Each entry is one isolated entity that has
# its OWN vendor lists (SD + Convo) and its own build queue — nothing is shared
# or merged between entities. Fields:
#   id       stable storage key — set it once and never change it (data is keyed on it)
#   label    display name shown in the app's top bar
#   username / password  the login credentials for that entity
#   primary  set true on exactly ONE entity; it inherits any vendor data that was
#            uploaded before multi-tenancy existed (one-time, first boot only)
# Set this as a single-line JSON array (mind the shell quoting in Coolify):
# AUTH_ACCOUNTS=[{"id":"entity-a","label":"Entity A","username":"a_user","password":"a_pass","primary":true},{"id":"entity-b","label":"Entity B","username":"b_user","password":"b_pass"},{"id":"entity-c","label":"Entity C","username":"c_user","password":"c_pass"},{"id":"entity-d","label":"Entity D","username":"d_user","password":"d_pass"},{"id":"entity-e","label":"Entity E","username":"e_user","password":"e_pass"}]

# Legacy single-login fallback — used only if AUTH_ACCOUNTS is not set (id "default").
# AUTH_USERNAME=admin
# AUTH_PASSWORD=change-me
